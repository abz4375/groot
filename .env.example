# Copy to `.env` and edit. Everything here is optional.

# --- HTTP -------------------------------------------------------------------
# Port published on the host.
API_PORT=8000

# Bearer token required by every /v1 endpoint. LEAVE EMPTY ONLY ON A TRUSTED
# NETWORK — with no token the API is open to anyone who can reach the port.
API_BEARER_TOKEN=

# Comma-separated CORS allow-list. Empty disables CORS middleware entirely.
CORS_ORIGINS=

# --- Runtime limits ---------------------------------------------------------
LOG_LEVEL=INFO
MAX_CONCURRENCY=2
DEFAULT_TIMEOUT_SECONDS=900
MAX_TIMEOUT_SECONDS=3600
MAX_PROMPT_CHARS=200000
QUEUE_WAIT_SECONDS=1.0

# --- agy --------------------------------------------------------------------
# Extra environment variables handed to every agy process (JSON object).
# AGY_ENV={"SOME_VAR": "value"}

# Use Application Default Credentials instead of the interactive login:
# AGY_ADC_AUTH=true
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/adc.json

# Or an API key (check the agy docs for which env var your version honours):
# GEMINI_API_KEY=

# agy already runs with AGY_CLI_DISABLE_AUTO_UPDATE=true in the image; only
# override this if you know you want the self-updater inside a container.
# AGY_CLI_DISABLE_AUTO_UPDATE=false
