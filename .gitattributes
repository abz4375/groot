# Normalise line endings so shell scripts stay runnable everywhere.
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# PowerShell and Windows batch files want CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
